# Precision Performance environment template
# Copy this file to .env.local for local development, then fill values locally.
# Never commit real secrets. Do not paste secret values into chat or planning docs.

# App / Vercel
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VERCEL_ENV=development

# Supabase
# Public browser-safe project URL and anon key. Required for auth, portal, admin reads, and data workflows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase service role key. Required for bootstrap, admin membership tools, and checkout persistence.
SUPABASE_SERVICE_ROLE_KEY=

# Public enquiry delivery and maintenance. All values are server-only.
# Keep blank unless a later activation sprint directs otherwise. Only exact lowercase enabled activates public submission.
PUBLIC_ENQUIRY_SUBMISSION_ENABLED=
PUBLIC_ENQUIRY_SMTP_HOST=
PUBLIC_ENQUIRY_SMTP_PORT=
PUBLIC_ENQUIRY_SMTP_USER=
PUBLIC_ENQUIRY_SMTP_PASS=
SMTP_FROM=
CONTACT_ENQUIRY_EMAIL=
ENQUIRY_ABUSE_HMAC_SECRET=
CRON_SECRET=

# Stripe test-mode values for local/preview verification.
# Use pk_test_ / sk_test_ / whsec_ values locally or in preview.
# Use live values only in production after checkout and webhook replay have passed in test mode.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional legacy/status marker. Leave blank unless a later sprint activates Railway-specific integrations.
RAILWAY_API_TOKEN=

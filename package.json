    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "autoprefixer": "10.4.21",
    "eslint": "^9.25.1",
    "eslint-config-next": "15.3.8",
    "node": "22.14.0",
    "postcss": "8.5.3",
    "supabase": "^2.109.1",
    "tailwindcss": "3.4.17",
